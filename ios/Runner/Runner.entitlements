<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Use "production" for App Store builds
	     (Xcode sets this automatically when archiving with a distribution profile). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
